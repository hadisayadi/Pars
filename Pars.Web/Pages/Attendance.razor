@page "/attendance"
@inject ApiClient Api
<h1>حضور و غیاب</h1>
<div class="toolbar"><input @bind="_personId" placeholder="کد پرسنلی"/><input @bind="_from" placeholder="از تاریخ شمسی"/><input @bind="_to" placeholder="تا تاریخ شمسی"/><button @onclick="LoadDaily">نمایش کارکرد</button></div>
@if(!string.IsNullOrWhiteSpace(_error)){<div class="error">@_error</div>}<Busy Value="_loading" />
@if(_daily.Count>0){<div class="table-wrap"><table><thead><tr><th>تاریخ</th><th>ورود</th><th>خروج</th><th>حضور</th><th>وظیفه</th><th>تأخیر</th><th>تعجیل</th><th>اضافه‌کار</th><th>مرخصی ساعتی</th><th>مأموریت ساعتی</th><th>وضعیت</th></tr></thead><tbody>@foreach(var d in _daily){<tr><td>@d.PersianDate</td><td>@Fmt(d.Arrival)</td><td>@Fmt(d.Departure)</td><td>@d.AttendanceMinutes</td><td>@d.DutyMinutes</td><td>@d.LateMinutes</td><td>@d.EarlyDepartureMinutes</td><td>@d.OvertimeMinutes</td><td>@d.HourlyLeaveMinutes</td><td>@d.HourlyMissionMinutes</td><td>@d.Status</td></tr>}</tbody></table></div>}
<div class="two-col"><div class="panel"><h3>ثبت ورود/خروج دستی</h3><label>نوع<input @bind="_manual.Kind" placeholder="IN / OUT"/></label><label>تاریخ<input @bind="_manual.Date" placeholder="1405/05/01"/></label><label>ساعت<input type="time" @bind="_manual.TimeText"/></label><label>توضیح<textarea @bind="_manual.Description"></textarea></label><button @onclick="CreateManual">ثبت</button></div>
<div class="panel"><h3>ثبت مأموریت</h3><label>از تاریخ<input @bind="_mission.DateFrom"/></label><label>تا تاریخ<input @bind="_mission.DateTo"/></label><label>مقصد<input @bind="_mission.Destination"/></label><label>موضوع<input @bind="_mission.Subject"/></label><label><input type="checkbox" @bind="_mission.HasVehicle"/> نیاز به خودرو</label><button @onclick="CreateMission">ثبت مأموریت</button></div></div>
@code{
 string _personId="",_from="",_to=""; bool _loading; string? _error; List<DailyDto> _daily=new(); ManualForm _manual=new(); MissionForm _mission=new();
 async Task LoadDaily(){if(string.IsNullOrWhiteSpace(_personId))return;_loading=true;_error=null;try{var u=$"api/attendance/daily?PersonId={Uri.EscapeDataString(_personId)}";if(!string.IsNullOrWhiteSpace(_from))u+="&FromPersianDate="+Uri.EscapeDataString(_from);if(!string.IsNullOrWhiteSpace(_to))u+="&ToPersianDate="+Uri.EscapeDataString(_to);_daily=await Api.GetAsync<List<DailyDto>>(u)??new();}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
 async Task CreateManual(){try{if(!TimeSpan.TryParse(_manual.TimeText,out var t))throw new Exception("ساعت معتبر وارد کنید.");await Api.PostAsync<object>("api/attendance/manual",new{PersonId=_personId,_manual.Kind,_manual.Date,Time=t,_manual.Description});_manual=new();}catch(Exception ex){_error=ex.Message;}}
 async Task CreateMission(){try{await Api.PostAsync<object>("api/attendance/missions",new{PersonId=_personId,_mission.DateFrom,_mission.DateTo,_mission.Destination,_mission.Subject,_mission.HasVehicle});_mission=new();}catch(Exception ex){_error=ex.Message;}}
 static string Fmt(DateTime? d)=>d?.ToString("HH:mm")??"-";
 sealed class DailyDto{public string? PersianDate{get;set;}public DateTime? Arrival{get;set;}public DateTime? Departure{get;set;}public int AttendanceMinutes{get;set;}public int DutyMinutes{get;set;}public int LateMinutes{get;set;}public int EarlyDepartureMinutes{get;set;}public int OvertimeMinutes{get;set;}public int HourlyLeaveMinutes{get;set;}public int HourlyMissionMinutes{get;set;}public string? Status{get;set;}}
 sealed class ManualForm{public string Kind{get;set;}="";public string Date{get;set;}="";public string TimeText{get;set;}="";public string? Description{get;set;}}
 sealed class MissionForm{public string DateFrom{get;set;}="";public string DateTo{get;set;}="";public string? Destination{get;set;}public string? Subject{get;set;}public bool HasVehicle{get;set;}}
}
